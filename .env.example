# Mnemo Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Optional: Cloud LLM (not required — app works with Ollama or rule-based)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Server config
# MNEMO_SERVER_PORT=8765
# MNEMO_OLLAMA_HOST=http://localhost:11434
# MNEMO_OLLAMA_MODEL=qwen3.5:9b

# Vault path (default: ./MnemoVault)
# MNEMO_VAULT_PATH=./MnemoVault
